# Optional: only change these if your XAMPP MySQL/MariaDB settings are different.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=islearning

# Gemini AI/LLM
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
# Used only if the selected model is temporarily unavailable. Keep these as real Gemini models.
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash

# Hybrid AI: Gemini primary, local Ollama fallback when Gemini fails/quota is exhausted.
AI_PROVIDER_MODE=hybrid
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_SOURCE_CHARS=50000
